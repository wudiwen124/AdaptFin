# LLM（OpenAI 兼容格式，按你的提供商填写）
LLM_API_KEY=sk-xxxx
# 智谱(zhipu/bigmodel)示例：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.deepseek.com/v1
ADVISOR_ROUTER_MODEL=glm-4.7-flash
ADVISOR_DEEP_MODEL=glm-4.7-flash

# 数据源优先级（逗号分隔；demo 会自动追加到最后兜底）
ADVISOR_SOURCES_PRIORITY=akshare,baostock

# tushare 可选
TUSHARE_TOKEN=

# 语义记忆向量（可选：SiliconFlow 的 BAAI/bge-m3）
# EMBED_API_KEY=sk-xxxx
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# ADVISOR_MEMORY_EMBEDDER=siliconflow
# ADVISOR_EMBED_MODEL=BAAI/bge-m3

# 覆盖默认配置路径
# ADVISOR_SETTINGS_PATH=configs/settings.yaml
